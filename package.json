{
  "name": "latexdo-org",
  "version": "0.1.0",
  "private": true,
  "description": "Static TypeScript website for LatexDo.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:footers": "node scripts/check-footers.mjs",
    "dev": "serve -l 8787 .",
    "preview": "serve -l 8787 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "serve": "^14.2.6",
    "wrangler": "^4.130.0"
  }
}
