{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "latexdo-org",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // The Worker handles pages and the JSON feeds. Stylesheets, scripts, images
    // and the shared partials are served straight from the edge without it.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/style.css",
      "!/research/assets/*",
      "!/research/style.css",
      "!/partials/*"
    ],
    "not_found_handling": "404-page"
  }
}
